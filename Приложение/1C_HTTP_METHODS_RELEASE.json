{
  "contractVersion": "2.0.0",
  "application": "ITUS Service MAX",
  "transport": "HTTPS POST, application/json; charset=utf-8, without BOM",
  "basePath": "/aa6_ea_test9/ru/hs/max-service",
  "commonRequestFields": {
    "requestId": "UUID generated by the app; use for idempotency and logging",
    "timestamp": "ISO 8601 UTC timestamp",
    "userId": "numeric MAX user ID",
    "maxUserId": "same as userId",
    "authId": "same as userId for compatibility",
    "authMode": "max | manual | qr",
    "miniApp": "ITUS",
    "version": "itus-max-2.0.0",
    "max": "MAX WebApp context"
  },
  "commonSuccess": {
    "success": true,
    "requestId": "same requestId",
    "timestamp": "2026-07-20T10:00:00+05:00",
    "data": {}
  },
  "commonError": {
    "success": false,
    "requestId": "same requestId",
    "timestamp": "2026-07-20T10:00:00+05:00",
    "error": {
      "code": "VALIDATION_ERROR",
      "message": "Human-readable Russian message",
      "details": [{ "field": "orderRef", "message": "Required" }]
    }
  },
  "dynamicFormSchema": {
    "form": {
      "title": "Данные приёма",
      "hint": "Поля определяются 1С",
      "fields": [
        { "id": "mileage", "label": "Пробег", "type": "number", "required": true, "unit": "км", "placeholder": "184500", "value": "" },
        { "id": "engineHours", "label": "Моточасы", "type": "number", "required": false, "unit": "м/ч", "value": "" },
        { "id": "reason", "label": "Дополнение к причине обращения", "type": "textarea", "required": false, "value": "" }
      ]
    },
    "survey": {
      "surveyRef": "SURVEY_GUID",
      "version": "1",
      "title": "Анкета приёма автомобиля",
      "hint": "Состав зависит от модели автомобиля",
      "questions": [
        {
          "id": "body_state",
          "text": "Состояние кузова",
          "type": "single",
          "required": true,
          "options": [
            { "value": "ok", "label": "Без замечаний" },
            { "value": "damaged", "label": "Есть повреждения" }
          ]
        }
      ]
    }
  },
  "fileSchema": {
    "fileName": "photo-001.jpg",
    "mimeType": "image/jpeg",
    "sizeBytes": 523000,
    "contentBase64": "BASE64_WITHOUT_DATA_URL_PREFIX",
    "clientFileId": "UUID"
  },
  "methods": {
    "/ping": {
      "purpose": "Connection check",
      "request": { "check": "ITUS" },
      "responseData": { "message": "OK" }
    },
    "/auth/max": {
      "purpose": "Resolve MAX ID to 1C employee, role and tabs",
      "request": { "userId": "13970179", "max": { "webAppData": "signed MAX init data" } },
      "responseData": {
        "user": { "maxUserId": "13970179", "employeeRef": "EMPLOYEE_GUID", "name": "Иванов Иван", "role": "master", "roleName": "Мастер-приёмщик", "businessUnit": "РИЦ" },
        "availableTabs": ["orders", "mp", "executor", "tech", "clients", "chat"]
      }
    },
    "/orders/list": {
      "purpose": "Orders available to the current user",
      "request": { "status": "active" },
      "responseData": {
        "orders": [{
          "orderRef": "ORDER_GUID", "orderNumber": "РИЦ-З22752", "orderDate": "2026-07-20T09:30:00+05:00",
          "status": { "code": "waiting_repair", "title": "Ожидание ремонта" },
          "client": { "counterpartyRef": "CLIENT_GUID", "name": "ООО Клиент" },
          "contact": { "contactRef": "CONTACT_GUID", "name": "Петров Пётр", "phone": "+79000000000" },
          "vehicle": { "vehicleRef": "VEHICLE_GUID", "model": "КАМАЗ 54901", "plate": "А000АА72", "vin": "VIN" },
          "mileage": 184500, "engineHours": 2100, "reason": "Проверить тормозную систему",
          "executor": { "employeeRef": "EMPLOYEE_GUID", "name": "Слесарь" },
          "post": { "postRef": "POST_GUID", "title": "Пост №1" },
          "worktime": { "packageRef": "PACKAGE_GUID", "status": "В работе" },
          "defectDocumentRef": "DEFECT_GUID",
          "unread": { "clientMessages": 1, "internalMessages": 2 },
          "counters": { "defects": 2, "documents": 3, "media": 4 },
          "updatedAt": "2026-07-20T10:00:00+05:00"
        }]
      }
    },
    "/orders/get": {
      "purpose": "Full order refresh",
      "request": { "orderRef": "ORDER_GUID", "orderId": "ORDER_GUID" },
      "responseData": { "order": "same object shape as /orders/list with optional defects and media arrays" }
    },
    "/orders/search": {
      "purpose": "Search by order number or QR value",
      "request": { "search": "РИЦ-З22752" },
      "responseData": { "orders": ["same order object"] }
    },
    "/acceptance/start": {
      "purpose": "Create or return the active acceptance act and model-dependent questionnaire",
      "request": { "orderRef": "ORDER_GUID" },
      "responseData": {
        "acceptance": {
          "documentRef": "ACCEPTANCE_GUID", "status": "created",
          "form": "dynamicFormSchema.form", "survey": "dynamicFormSchema.survey",
          "values": {}, "answers": {}
        }
      }
    },
    "/acceptance/complete": {
      "purpose": "Save and post the acceptance act; app hides the form after success",
      "request": {
        "orderRef": "ORDER_GUID", "documentRef": "ACCEPTANCE_GUID",
        "formValues": { "mileage": 184500, "engineHours": 2100, "reason": "ТО" },
        "surveyRef": "SURVEY_GUID", "surveyVersion": "1", "answers": { "body_state": "ok" }
      },
      "responseData": { "documentRef": "ACCEPTANCE_GUID", "completed": true, "status": "posted" }
    },
    "/resources/posts/list": {
      "purpose": "Posts permitted for the current user",
      "request": { "orderRef": "ORDER_GUID" },
      "responseData": { "posts": [{ "postRef": "POST_GUID", "title": "Пост №1", "description": "Свободен", "available": true }] }
    },
    "/resources/posts/assign": {
      "purpose": "Assign post to order",
      "request": { "orderRef": "ORDER_GUID", "postRef": "POST_GUID" },
      "responseData": { "postRef": "POST_GUID", "assigned": true }
    },
    "/resources/executors/planned/list": {
      "purpose": "Planned resources from planning calendar, shown first",
      "request": { "orderRef": "ORDER_GUID", "postRef": "POST_GUID" },
      "responseData": { "plannedExecutors": [{ "employeeRef": "EMPLOYEE_GUID", "name": "Петров П.П.", "schedule": "Запланирован 10:00-14:00", "planned": true, "available": true }] }
    },
    "/resources/executors/list": {
      "purpose": "All permitted employees after user selects 'other executor'",
      "request": { "orderRef": "ORDER_GUID", "postRef": "POST_GUID" },
      "responseData": { "executors": [{ "employeeRef": "EMPLOYEE_GUID", "name": "Иванов И.И.", "role": "Автослесарь", "available": true }] }
    },
    "/executor/assign": {
      "purpose": "Assign employee and create notification for executor",
      "request": { "orderRef": "ORDER_GUID", "employeeRef": "EMPLOYEE_GUID", "executorRef": "EMPLOYEE_GUID", "postRef": "POST_GUID", "notifyExecutor": true },
      "responseData": { "assigned": true, "notificationCreated": true, "eventId": "EVENT_GUID" }
    },
    "/workshop/work/start": {
      "purpose": "Start executor work in Employee of workshop module and return model-dependent checklist",
      "request": { "orderRef": "ORDER_GUID", "executorRef": "EMPLOYEE_GUID" },
      "responseData": {
        "checklist": { "documentRef": "CHECKLIST_GUID", "status": "created", "form": { "fields": [] }, "survey": "dynamicFormSchema.survey", "answers": {} },
        "package": { "packageRef": "PACKAGE_GUID", "status": "В работе" }
      }
    },
    "/checklist/complete": {
      "purpose": "Save and post checklist; app hides it after success",
      "request": { "orderRef": "ORDER_GUID", "documentRef": "CHECKLIST_GUID", "surveyRef": "SURVEY_GUID", "surveyVersion": "1", "answers": { "brakes": "ok" }, "formValues": {} },
      "responseData": { "documentRef": "CHECKLIST_GUID", "completed": true }
    },
    "/defects/start": {
      "purpose": "Return existing defect sheet from document tree or create a new one",
      "request": { "orderRef": "ORDER_GUID", "existingDocumentRef": "DEFECT_GUID_OR_EMPTY" },
      "responseData": {
        "defectSheet": {
          "documentRef": "DEFECT_GUID", "status": "draft", "created": true,
          "entries": [{ "entryRef": "ENTRY_GUID", "type": "text", "text": "Люфт", "authorName": "Слесарь", "createdAt": "2026-07-20T10:10:00+05:00" }]
        }
      }
    },
    "/defects/entries/add": {
      "purpose": "Add text, photo, video or voice entry to defect sheet; file is Base64 JSON",
      "request": {
        "orderRef": "ORDER_GUID", "documentRef": "DEFECT_GUID", "clientEntryId": "UUID",
        "entry": { "clientEntryId": "UUID", "type": "text | photo | video | voice", "text": "Описание", "file": "fileSchema when entry has media" }
      },
      "responseData": {
        "entry": { "entryRef": "ENTRY_GUID", "type": "photo", "text": "", "file": { "fileRef": "FILE_GUID", "fileName": "photo.jpg", "mimeType": "image/jpeg", "sizeBytes": 523000 }, "authorName": "Слесарь", "createdAt": "2026-07-20T10:10:00+05:00" }
      }
    },
    "/defects/complete": {
      "purpose": "Post defect sheet",
      "request": { "orderRef": "ORDER_GUID", "documentRef": "DEFECT_GUID" },
      "responseData": { "documentRef": "DEFECT_GUID", "completed": true }
    },
    "/voice/transcribe": {
      "purpose": "Convert a saved voice defect entry to text",
      "request": { "orderRef": "ORDER_GUID", "documentRef": "DEFECT_GUID", "entryRef": "ENTRY_GUID", "fileRef": "FILE_GUID", "language": "ru-RU" },
      "responseData": { "entryRef": "ENTRY_GUID", "transcript": "Распознанный текст голосового сообщения" }
    },
    "/worktime/packages/create": {
      "purpose": "Create worktime package",
      "request": { "orderRef": "ORDER_GUID", "packageRef": "" },
      "responseData": { "package": { "packageRef": "PACKAGE_GUID", "status": "Создан" } }
    },
    "/worktime/packages/start": {
      "purpose": "Start worktime package",
      "request": { "orderRef": "ORDER_GUID", "packageRef": "PACKAGE_GUID" },
      "responseData": { "package": { "packageRef": "PACKAGE_GUID", "status": "В работе" } }
    },
    "/worktime/packages/pause": {
      "purpose": "Pause worktime package",
      "request": { "orderRef": "ORDER_GUID", "packageRef": "PACKAGE_GUID" },
      "responseData": { "package": { "packageRef": "PACKAGE_GUID", "status": "Перерыв" } }
    },
    "/worktime/packages/close": {
      "purpose": "Close worktime package",
      "request": { "orderRef": "ORDER_GUID", "packageRef": "PACKAGE_GUID" },
      "responseData": { "package": { "packageRef": "PACKAGE_GUID", "status": "Закрыт" } }
    },
    "/worktime/production": {
      "purpose": "Closed hours of current workshop employee",
      "request": { "employeeRef": "EMPLOYEE_GUID", "period": "today" },
      "responseData": { "production": { "closedHours": 5.4, "closedPackages": 2 }, "items": [{ "packageNumber": "УРВ-1", "orderNumber": "РИЦ-З22752", "hours": 3.2, "closedAt": "2026-07-20T12:00:00+05:00" }] }
    },
    "/quality/start": {
      "purpose": "Create quality-control document and return model-dependent survey",
      "request": { "orderRef": "ORDER_GUID", "source": "manual | notification" },
      "responseData": { "qualityControl": { "documentRef": "QUALITY_GUID", "status": "created", "form": { "fields": [] }, "survey": "dynamicFormSchema.survey", "answers": {} } }
    },
    "/quality/complete": {
      "purpose": "Save and post quality control; app hides it after success",
      "request": { "orderRef": "ORDER_GUID", "documentRef": "QUALITY_GUID", "surveyRef": "SURVEY_GUID", "surveyVersion": "1", "answers": { "result": "passed" }, "formValues": {} },
      "responseData": { "documentRef": "QUALITY_GUID", "completed": true, "result": "passed" }
    },
    "/quality/current-appeal": {
      "purpose": "Reason for current visit",
      "request": { "orderRef": "ORDER_GUID" },
      "responseData": { "appeal": { "reason": "Проверить тормозную систему", "createdAt": "2026-07-20T09:30:00+05:00" } }
    },
    "/quality/service-history/pdf": {
      "purpose": "Generate service history PDF and return it for download",
      "request": { "orderRef": "ORDER_GUID", "vehicleRef": "VEHICLE_GUID", "vehiclePlate": "А000АА72" },
      "responseData": { "file": { "fileRef": "FILE_GUID", "fileName": "История_обслуживания.pdf", "mimeType": "application/pdf", "sizeBytes": 125000, "contentBase64": "BASE64_OR_EMPTY_IF_DOWNLOAD_URL", "downloadUrl": "OPTIONAL_SAME_ORIGIN_URL" } }
    },
    "/notifications/poll": {
      "purpose": "Polling channel for executor assignments and quality requests",
      "request": { "cursor": "LAST_CURSOR", "limit": 20 },
      "responseData": {
        "nextCursor": "CURSOR_101",
        "events": [
          { "eventId": "EVENT_1", "type": "executor_assigned", "title": "Назначен ЗН", "message": "Откройте заказ-наряд", "orderRef": "ORDER_GUID", "createdAt": "2026-07-20T10:00:00+05:00", "payload": {} },
          { "eventId": "EVENT_2", "type": "quality_control_requested", "title": "Требуется осмотр", "message": "МП запросил осмотр технолога", "orderRef": "ORDER_GUID", "createdAt": "2026-07-20T10:01:00+05:00", "payload": {} }
        ]
      }
    },
    "/clients/topics/list": {
      "purpose": "B2B client topics available to user",
      "request": { "status": "active" },
      "responseData": { "topics": [{ "topicRef": "TOPIC_GUID", "title": "ООО Клиент", "subtitle": "Петров Пётр", "lastMessage": "Ждём согласование", "unreadCount": 1, "orderRef": "ORDER_GUID", "orderNumber": "РИЦ-З22752", "vehiclePlate": "А000АА72" }] }
    },
    "/clients/messages/list": {
      "purpose": "Client topic history",
      "request": { "topicRef": "TOPIC_GUID", "topicId": "TOPIC_GUID" },
      "responseData": { "messages": [{ "messageRef": "MESSAGE_GUID", "direction": "incoming", "authorName": "Клиент", "text": "Добрый день", "createdAt": "2026-07-20T10:00:00+05:00", "attachments": [] }] }
    },
    "/clients/messages/send": {
      "purpose": "Send B2B text message through 1C",
      "request": { "topicRef": "TOPIC_GUID", "topicId": "TOPIC_GUID", "clientMessageId": "UUID", "text": "Сообщение" },
      "responseData": { "messageRef": "MESSAGE_GUID", "sent": true }
    },
    "/clients/files/send": {
      "purpose": "Send B2B file/photo/video through 1C",
      "request": { "topicRef": "TOPIC_GUID", "topicId": "TOPIC_GUID", "clientMessageId": "UUID", "kind": "photo | video | file", "file": "fileSchema" },
      "responseData": { "messageRef": "MESSAGE_GUID", "fileRef": "FILE_GUID", "sent": true }
    },
    "/internal-chat/groups/list": {
      "purpose": "Department groups according to rights",
      "request": {},
      "responseData": { "groups": [{ "groupRef": "GROUP_GUID", "title": "Передача смены", "subtitle": "Общий чат", "lastMessage": "Принято", "unreadCount": 2 }] }
    },
    "/internal-chat/messages/list": {
      "purpose": "Department group history",
      "request": { "groupRef": "GROUP_GUID", "groupId": "GROUP_GUID" },
      "responseData": { "messages": [{ "messageRef": "MESSAGE_GUID", "direction": "incoming", "authorName": "Сотрудник", "text": "Сообщение", "createdAt": "2026-07-20T10:00:00+05:00", "attachments": [] }] }
    },
    "/internal-chat/messages/send": {
      "purpose": "Send department text message through 1C",
      "request": { "groupRef": "GROUP_GUID", "groupId": "GROUP_GUID", "clientMessageId": "UUID", "text": "Сообщение" },
      "responseData": { "messageRef": "MESSAGE_GUID", "sent": true }
    },
    "/internal-chat/files/send": {
      "purpose": "Send department attachment through 1C",
      "request": { "groupRef": "GROUP_GUID", "groupId": "GROUP_GUID", "clientMessageId": "UUID", "kind": "photo | video | file", "file": "fileSchema" },
      "responseData": { "messageRef": "MESSAGE_GUID", "fileRef": "FILE_GUID", "sent": true }
    }
  },
  "requiredHttpStatuses": {
    "200": "success",
    "400": "invalid JSON or validation error",
    "401": "invalid token or MAX signature",
    "403": "user has no rights",
    "404": "object or route not found",
    "409": "business conflict or duplicate in progress",
    "413": "attachment is too large",
    "422": "business validation failed",
    "500": "unexpected 1C error"
  },
  "idempotency": "For create/send operations, store requestId and clientEntryId/clientMessageId. Repeated request must return the original successful result without creating a duplicate."
}
