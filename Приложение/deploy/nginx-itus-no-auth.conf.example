# Пример отдельного поддомена без сайта-входа.
# Укажите A-запись: itus.eazia.ru -> IP сервера
# И тогда запрос к https://itus.eazia.ru/ будет идти напрямую в приложение.
# Если приложение размещается на том же домене, то блок /p/max-service/ нужно
# поставить ДО общих правил /login, /auth и generic location /.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name itus.eazia.ru;

    ssl_certificate     /etc/letsencrypt/live/itus.eazia.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/itus.eazia.ru/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_connect_timeout 10s;
        client_max_body_size 32m;
    }
}

server {
    listen 80;
    server_name itus.eazia.ru;
    return 301 https://$host$request_uri;
}

# Альтернатива: если хотите оставить тот же домен, но без login на определённом пути,
# вставьте этот блок ПЕРЕД основным блоком с /login и другими правилами сайта:
#
# location = /p/max-service {
#     return 308 /p/max-service/;
# }
#
