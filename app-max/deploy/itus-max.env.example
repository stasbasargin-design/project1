PORT=8080
# Для публикации в корне домена оставьте пустым или удалите строку.
# Для публикации в подпути используйте, например, /p/max-service.
APP_BASE_PATH=/p/max-service
# Retained from the supplied project. Confirm the desired production database before going live.
ONE_C_TARGET=https://1c.eazia.ru/aa6_ea_test9/ru/hs/max-service
ONE_C_TOKEN=
# Заполняйте только если публикация 1С защищена HTTP Basic Authentication.
# Не добавляйте эти значения в config/itus.config.js.
ONE_C_BASIC_USER=
ONE_C_BASIC_PASSWORD=
PROXY_TIMEOUT_MS=120000
MAX_REQUEST_BYTES=104857600
LOG_PROXY_REQUESTS=true
# Firebase Admin SDK: the JSON private key must live outside the repository.
# The itus service user must be able to read this file (for example root:itus, 0640).
GOOGLE_APPLICATION_CREDENTIALS=/opt/itus/secrets/firebase-service-account.json
# A separate random secret for server-to-server calls from 1C to /api/push/*.
PUSH_INTERNAL_TOKEN=
