    "data": {}
  },
  "commonError": {
    "success": false,
    "requestId": "same requestId",
    "timestamp": "2026-07-20T10:00:00+05:00",
    "error": {
      "code": "VALIDATION_ERROR",
      "message": "Human-readable Russian message",
      "details": [
        {
          "field": "orderRef",
          "message": "Required"
        }
      ]
    }
  },
  "dynamicFormSchema": {
    "form": {
      "title": "Данные приёма",
      "hint": "Поля определяются 1С",
      "fields": [
        {
          "id": "mileage",
          "label": "Пробег",
          "type": "number",
          "required": true,
          "unit": "км",
          "placeholder": "184500",
          "value": ""
        },
        {
          "id": "engineHours",
          "label": "Моточасы",
          "type": "number",
          "required": false,
          "unit": "м/ч",
          "value": ""
        },
        {
          "id": "reason",
          "label": "Дополнение к причине обращения",
          "type": "textarea",
          "required": false,
          "value": ""
        }
      ]
    },
    "survey": {
      "surveyRef": "SURVEY_GUID",
      "version": "1",
      "title": "Анкета приёма автомобиля",
      "hint": "Состав зависит от модели автомобиля",
      "questions": [
        {
          "id": "body_state",
          "text": "Состояние кузова",
          "type": "single",
          "required": true,
          "options": [
            {
              "value": "ok",
              "label": "Без замечаний"
            },
            {
              "value": "damaged",
              "label": "Есть повреждения"
            }
          ]
        }
      ]
    }
  },
  "fileSchema": {
    "fileName": "photo-001.jpg",
    "mimeType": "image/jpeg",
