    "/worktime/packages/create": {
      "purpose": "Атомарное создание пакета из работ ЗН и участников; packageRef не требуется",
      "request": {
        "orderRef": "ORDER_GUID",
        "workshopRef": "WORKSHOP_GUID",
        "workRefs": [
          "ORDER_WORK_ROW_GUID"
        ],
        "participants": [
          {
            "employeeRef": "EMPLOYEE_GUID",
            "percent": 60
          },
          {
            "employeeRef": "COLLEAGUE_GUID",
            "percent": 40
          }
        ],
        "clientPackageId": "UUID_STABLE_FOR_RETRY"
      },
      "responseData": {
        "package": {
          "packageRef": "PACKAGE_GUID",
          "status": "Создан"
        }
      },
      "validation": [
        "workRefs: непустые уникальные ссылки строк работ ЗН (не ссылки каталога работ)",
        "participants: уникальные employeeRef; проценты > 0, <= 100, максимум 2 десятичных знака; сумма ровно 100%",
        "1С повторно проверяет права, цех, доступность работ и сотрудников в транзакции создания",
        "clientPackageId: повтор с тем же составом возвращает тот же пакет; другой состав с тем же ключом — конфликт; requestId сохраняет прежнее значение для трассировки отдельного запроса",
        "В транзакции проверить отсутствие активного пакета для каждой строки работ; при конфликте 409, пакет не создавать"
      ]
